<!DOCTYPE html>
html(lang="en")
    head
        meta(charset="UTF-8")
        meta(name="viewport", content="width=device-width, initial-scale=1.0")
        meta(http-equiv="X-UA-Compatible", content="ie=edge")
        title Fireworks
        link(rel="stylesheet", href="site.css")
    body
        img#moonImage(src="./assets/Moon.png").hidden-element
        img#rocketSpriteImage(src="./assets/RocketSprite.png").hidden-element
        img#panoramaImage(src="./assets/Panorama.png").hidden-element
        //- img#logoImage(src="./assets/Logo.png").hidden-element

        //- p.font-handwrite.hidden-element Must Use this
        p.font-pf.hidden-element Must Use this
        p.font-other.hidden-element Must Use this

        .whole-screen-fixed
        .screen
            .top.hide-opacity#scoreContainerElement
                p.font-other Zbývá <span id='scoreElement'></span> ohňostrojů k vidění
            .middle
                .flex-center.hide-opacity#helpElement
                    p.help-text.font-other Klikni na raketu a uvidíš ohňostroj
            .bottom
                .flex-center
                    button#startButton.hide-opacity.font-other Start

        script(src="site.js")